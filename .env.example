# Supabase project credentials (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key. Bypasses RLS - used for account deletion.
# Never expose this client-side or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used for metadata, OG images and the sitemap.
# Set to your production domain when deploying (e.g. https://camelclock.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
